# Copy to .env (docker compose reads it automatically) and adjust.
# All backend settings are read from FS_* variables - see backend/fraudstream/config.py.

# --- queue -----------------------------------------------------------------
FS_QUEUE_BACKEND=redis            # memory | redis | kafka
FS_REDIS_URL=redis://redis:6379/0
FS_KAFKA_BOOTSTRAP=kafka:9092
FS_TX_TOPIC=transactions
FS_ALERT_TOPIC=alerts
FS_CONSUMER_GROUP=scorer

# --- model -----------------------------------------------------------------
FS_MODEL_DIR=/models
FS_MODEL_NAME=fraud_xgb
# FS_ALERT_THRESHOLD=0.5         # override the threshold stored with the model

# --- storage ---------------------------------------------------------------
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraudstream
FS_DATABASE_URL=postgresql+psycopg://fraud:fraud@postgres:5432/fraudstream

# --- drift -----------------------------------------------------------------
FS_DRIFT_WINDOW=5000
FS_DRIFT_PSI_WARN=0.1
FS_DRIFT_PSI_ALERT=0.2

# --- api -------------------------------------------------------------------
FS_API_PORT=8000
FS_CORS_ORIGINS=*
FS_LOG_LEVEL=info

# --- replay ----------------------------------------------------------------
REPLAY_SPEED=120                  # dataset-seconds per wall-clock second
REPLAY_ARGS=--loop                # extra flags, e.g. "--rate 200 --limit 50000"

# --- host ports ------------------------------------------------------------
API_PORT=8000
DASHBOARD_PORT=3000
PROMETHEUS_PORT=9090
