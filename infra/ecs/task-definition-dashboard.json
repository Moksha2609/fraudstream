{
  "family": "fraudstream-dashboard",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/fraudstream-task-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/fraudstream-task",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "containerDefinitions": [
    {
      "name": "dashboard",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/fraudstream/dashboard:latest",
      "essential": true,
      "portMappings": [
        { "name": "dashboard", "containerPort": 80, "protocol": "tcp", "appProtocol": "http" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fraudstream/dashboard",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "dashboard"
        }
      }
    }
  ]
}
